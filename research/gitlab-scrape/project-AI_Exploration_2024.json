ight\">20</td>\r\n<td align=\"right\">6</td>\r\n<td align=\"right\">0</td>\r\n</tr>\r\n<tr>\r\n<td align=\"right\">1</td>\r\n<td align=\"right\">3</td>\r\n<td align=\"right\">7</td>\r\n<td align=\"right\">0</td>\r\n</tr>\r\n<tr>\r\n<td align=\"right\">0</td>\r\n<td align=\"right\">1</td>\r\n<td align=\"right\">4</td>\r\n<td align=\"right\">7</td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td>model rozwiązujący</td>\r\n<td>AVERAGE of ocena Gemini</td>\r\n<td>AVERAGE of ocena Grok</td>\r\n<td>AVERAGE of ocena GPT</td>\r\n<td>AVERAGE of ground truth oceny</td>\r\n</tr>\r\n<tr>\r\n<td>ChatGPT</td>\r\n<td align=\"right\">1.125</td>\r\n<td align=\"right\">1.25</td>\r\n<td align=\"right\">1.625</td>\r\n<td align=\"right\">1.125</td>\r\n</tr>\r\n<tr>\r\n<td>Gemini 2.5 Flash</td>\r\n<td align=\"right\">1.75</td>\r\n<td align=\"right\">1.25</td>\r\n<td align=\"right\">1.25</td>\r\n<td align=\"right\">1.625</td>\r\n</tr>\r\n<tr>\r\n<td>Grok 4 (Fast)</td>\r\n<td align=\"right\">1.125</td>\r\n<td align=\"right\">1.25</td>\r\n<td align=\"right\">1</td>\r\n<td align=\"right\">0.875</td>\r\n</tr>\r\n<tr>\r\n<td>Llama 4</td>\r\n<td align=\"right\">1.375</td>\r\n<td align=\"right\">0.625</td>\r\n<td align=\"right\">1.125</td>\r\n<td align=\"right\">1</td>\r\n</tr>\r\n<tr>\r\n<td>Mistral</td>\r\n<td align=\"right\">1.125</td>\r\n<td align=\"right\">1.375</td>\r\n<td align=\"right\">1.375</td>\r\n<td align=\"right\">1.125</td>\r\n</tr>\r\n<tr>\r\n<td>Parafraza</td>\r\n<td align=\"right\">1.875</td>\r\n<td align=\"right\">1.75</td>\r\n<td align=\"right\">1.75</td>\r\n<td align=\"right\">2</td>\r\n</tr>\r\n</table>\r\n\r\n<table>\r\n<tr>\r\n<td>przedziały ufności</td>\r\n<td>ocena Gemini</td>\r\n<td>ocena Grok</td>\r\n<td>ocena GPT</td>\r\n<td>ground truth</td>\r\n</tr>\r\n<tr>\r\n<td>ChatGPT</td>\r\n<td>0.68 - 1.57</td>\r\n<td>0.76 - 1.74</td>\r\n<td>1.27 - 1.98</td>\r\n<td>0.55 - 1.7</td>\r\n</tr>\r\n<tr>\r\n<td>Gemini 2.5 Flash</td>\r\n<td>1.43 - 2.07</td>\r\n<td>0.76 - 1.74</td>\r\n<td>0.76 - 1.74</td>\r\n<td>1.11 - 2.14</td>\r\n</tr>\r\n<tr>\r\n<td>Grok 4 (Fast)</td>\r\n<td>0.44 - 1.81</td>\r\n<td>0.64 - 1.86</td>\r\n<td>0.36 - 1.64</td>\r\n<td>0.19 - 1.56</td>\r\n</tr>\r\n<tr>\r\n<td>Llama 4</td>\r\n<td>0.74 - 2.01</td>\r\n<td>0.11 - 1.14</td>\r\n<td>0.68 - 1.57</td>\r\n<td>0.48 - 1.52</td>\r\n</tr>\r\n<tr>\r\n<td>Mistral</td>\r\n<td>0.55 - 1.7</td>\r\n<td>0.74 - 2.01</td>\r\n<td>0.74 - 2.01</td>\r\n<td>0.44 - 1.81</td>\r\n</tr>\r\n<tr>\r\n<td>Parafraza</td>\r\n<td>1.63 - 2.12</td>\r\n<td>1.43 - 2.07</td>\r\n<td>1.43 - 2.07</td>\r\n<td align=\"right\">2</td>\r\n</tr>\r\n</table>\r\n\r\nNatomiast dla modeli lokalnych:\r\n\r\nAVERAGE oceny:\r\n\r\n* Openai's gpt-oss 20B - 1.57\r\n* Ernie 4.5 21B A3B - 0.5\r\n* Qwen3 Vi 30B - 1.5\r\n\r\nPrzedziały ufności:\r\n\r\n* Openai's gpt-oss 20B - 1.18 - 1.97\r\n* Ernie 4.5 21B A3B - 0 - 1.1\r\n* Qwen3 Vi 30B - 0.83 - 2.17\r\n\r\n## **Analiza wyników**\r\n\r\nJeśli chodzi o zdolności matematyczne, najlepszy okazał się Gemini 2.5 Flash ze średnią oceną ground truth 1.625. Na drugim miejscu uplasował się lokalny Openai's gpt-oss 20B a na trzecim Qwen3 Vi 30B. Dalej ex aequo mamy ChataGPT i Mistrala, trochę niżej Llamę 4. Pierwszym modelem, który uzyskał średnią ocen poniżej 1 był Grok 4 (Fast), a zdecydowanie najgorzej wypadł Ernie 4.5 21B A3B z mizernym wynikiem 0.5.\r\n\r\nPodczas oceny modeli sprawdzających zauważyliśmy pewną interesującą charakterystykę. Mianowicie, w ocenach Gemini i ChataGPT można zauważyć oczywistą faworyzację swoich własnych rozwiązań nad rozwiązaniami innych modeli.\r\n\r\nGemini średnio oceniał rozwiązania na 1.3 punkta, a sobie przyznawał aż 1.75. ChatGPT podobnie - średnio 1.275 punkta, a swoje rozwiązania wyceniał na 1.625. W porównaniu z ground truth Gemini “zawyżał” swoje wyniki o 0.125, a ChatGPT aż o 0.5!\r\n\r\nU Groka natomiast nie można zauważyć takiej sytuacji - ocena własnych rozwiązań nie wyróżniała się zbytnio od pozostałych, a nawet nie była ona najwyższa, ponieważ Grok oceniał rozwiązania Mistrala lepiej od swoich.\r\n\r\nJeśli chodzi o wyżej wspomnianą parafrazę, najwyżej ocenił ją Gemini, bo na 1.875 punkta, a Grok i ChatGPT na 1.75.\r\n\r\nJeśli chodzi natomiast o zgodność z ground truth to można ją zaobserwować poprzez analizę tabel pomyłek poszczególnych modeli. ChatGPT i Gemini uzyskały 70% poprawności, a Grok jedynie 62%.\r\n\r\nPodsumowując, najlepszym modelem sprawdzającym naszym zdaniem okazał się Gemini. 70% zgodności z ground truth daje mu znaczną przewagę nad Grokiem, a faworyzacja własnych rozwiązań była o wiele mniej widoczna niż w przypadku ChataGPT.\n```\n\n### Wiki: Nauka języków z AI\n```\n# Nauka języków z AI\r\n\r\n## Podsumowanie\r\nProjekt dotyczył zastosowania **Sztucznej Inteligencji** jako narzędzia wspierającego naukę języków obcych, ze szczególnym naciskiem na praktykę mówienia, wymowy i prowadzenie realistycznych konwersacji. \r\n\r\nCelem było sprawdzenie, czy asystent AI może pomóc w przełamywaniu bariery językowej poprzez dynamiczne dialogi. Choć testowano szereg dedykowanych aplikacji językowych, ostateczne testy wykazały, że to **zaawansowane modele LLM (ChatGPT i Gemini)** – przy zastosowaniu odpowiednich promptów – oferują najwyższą jakość dydaktyczną, lepszą logikę rozmowy i większą elastyczność niż zamknięte platformy komercyjne.\r\n\r\n---\r\n\r\n## Wykorzystywane narzędzia\r\nW procesie badawczym przetestowano dwa rodzaje rozwiązań:\r\n\r\n* **Modele LLM (Ogólne):**\r\n    * ChatGPT 4o\r\n    * Gemini 3 Pro\r\n* **Aplikacje dedykowane (Językowe):**\r\n    * Talkpal, SpeakPal, Talkio AI, Loora AI, Gliglish.\r\n\r\n---\r\n\r\n## Metodologia badania\r\nEwaluacja polegała na symulacji rozmów w językach: **angielskim, włoskim, francuskim i hiszpańskim**.\r\n\r\n### Profile użytkownika:\r\n1.  **Scenariusz A (Totalny Początkujący):** Ograniczone słownictwo, liczne błędy gramatyczne i logiczne.\r\n2.  **Scenariusz B (Średniozaawansowany):** Dobra baza teoretyczna, potrzeba szlifowania płynności i niuansów.\r\n\r\n### Kryteria oceny:\r\n* **Adaptacja do rozmówcy:** Zdolność do uproszczenia języka pod poziom użytkownika.\r\n* **Korekta błędów:** Skuteczność poprawek bez przerywania płynności rozmowy.\r\n* **Logika i spójność:** Naturalna ewolucja tematu i trzymanie się wątku.\r\n* **Jakość interakcji:** Intuicyjność obsługi głosowej i brak przerywania użytkownikowi.\r\n\r\n---\r\n\r\n## Wyniki: Aplikacje dedykowane\r\nMimo ukierunkowania na naukę języków, aplikacje te wykazały szereg ograniczeń:\r\n\r\n| Aplikacja | Główne spostrzeżenia | Ocena |\r\n| :--- | :--- | :--- |\r\n| **SpeakPal** | Dobry mechanizm *Push-to-Talk*, ale zbyt sztywny dla początkujących. | Dobra |\r\n| **Talkpal** | Powtarzalne scenariusze, nienaturalna synteza mowy. | Średnia |\r\n| **Loora AI** | Agresywne przerywanie użytkownikowi w chwilach wahania. | Niska |\r\n| **Gliglish / Talkio** | Surowe interfejsy, nielogiczne zmiany tematów. | Niska |\r\n\r\n---\r\n\r\n## Wyniki: Modele LLM\r\nW przeciwieństwie do aplikacji dedykowanych, które narzucają sztywne ramy, modele LLM oferują elastyczność, ale wymagają precyzyjnego promptowania. Testy przeprowadzono na dwóch wiodących modelach w scenariuszach \"Sklep\" oraz \"Taksówka\".\r\n\r\n### 1. ChatGPT\r\n* **Ogólna ocena:** Najlepszy start dla początkujących.\r\n* **Utrzymanie roli:** W testach języka włoskiego i francuskiego model bardzo dobrze trzymał się roli nauczyciela/sprzedawcy. Nie uciekał w dygresje, chyba że został o to poproszony.\r\n* **Utrzymanie poziomu:** W testach w językach francuskim i hiszpańskim dobrze trzymał się poziomu użytkownika.\r\n* **Korekta:** Bardzo dobrze radził sobie z wyłapywaniem błędów w rodzajnikach (np. *le/la* we francuskim) i udzielał korekt na bieżąco, nie przerywając wątku.\r\n\r\n### 2. Gemini\r\n* **Ogólna ocena:** Dobre narzędzie, ale wymagające dobrych promptów.\r\n* **Logika konwersacji:** Po odpowiednim ustawieniu prompta (w scenariuszu hiszpańskim), Gemini prowadziło bardziej spójną i logiczną rozmowę niż ChatGPT, zadając sensowne pytania pomocnicze.\r\n* **Zbyt wysoki poziom startowy:** W testach włoskiego i francuskiego, mimo próśb o poziom A1, Gemini generowało długie bloki tekstu i używało zbyt skomplikowanej gramatyki (*Passé Composé*), co przytłaczało użytkownika.\r\n* **Problemy z interakcją głosową:** Gorzej radziło sobie z rozpoznawaniem mowy osoby uczącej się (z obcym akcentem), co prowadziło do błędnych transkrypcji.\r\n\r\n---\r\n\r\n## Kluczowy czynnik: Inżynieria Promptów\r\nTesty jednoznacznie wykazały, że \"surowy\" model nie nadaje się do nauki od zera. Najlepsze rezultaty osiągnięto przy instrukcji zawierającej następujące elementy:\r\n\r\n* **Rola:** \"Jesteś gadatliwym kasjerem/taksówkarzem.\"\r\n* **Ograniczenie:** \"Używaj tylko poziomu A1, krótkich zdań.\"\r\n* **Format:** \"Jedno pytanie na raz. Czekaj na moją odpowiedź.\"\r\n* **Mechanizm korekty:** \"Jeśli zrobię błąd, popraw mnie krótko pod swoją wypowiedzią.\"\r\n\r\nBez klauzuli \"Czekaj na moją odpowiedź\", modele (szczególnie Gemini) mają tendencję do generowania całego dialogu naraz.\r\n\r\n### Przykładowe prompty:\r\n\r\n**Prompt dla języka hiszpańskiego (Poziom A1):**\r\n> Zasady naszej rozmowy:\r\n> 1. Poziom: Używaj tylko bardzo podstawowego hiszpańskiego (poziom A1), krótkich zdań i prostych słów.\r\n> 2. Format odpowiedzi: Każda Twoja wiadomość musi składać się z Twojej kwestii po hiszpańsku. Jeśli ja zrobię błąd – popraw mnie krótko pod spodem.\r\n> 3. Podtrzymywanie rozmowy: Zadawaj mi typowe pytania jak w sklepie.\r\n> 4. Interakcja: Nie pisz całej rozmowy naraz. Czekaj na moją odpowiedź po każdym Twoim zdaniu.\r\n> 5. Scenariusz: Zaczynamy w momencie, gdy podchodzę do kasy z zakupami. Zacznij teraz.\r\n\r\n**Prompt dla języka włoskiego (Nauczyciel):**\r\n> Wciel sie w role nauczyciela jezyka wloskiego. Odegrajmy scenke ze sklepu, ty bedziesz sprzedawca a ja bede kupowal. Zadawaj pytania po wlosku, nie tlumacz ich, ja odpowiem po wlosku i jesli nie bede potrzebowal pomocy to nie przechodz na jezyk polski. Po kazdej mojej odpowiedzi poprawiaj bledy, oczywiscie po wlosku. OK to zaczynam: Bongiorno, Io voglio comprare al pomodori, tre formaggio, un pane, orange juice e una birra. Dove sono all producto?\r\n\r\n---\r\n\r\n## Wnioski końcowe\r\nTesty wykazały, że LLMy, w szczególności **ChatGPT**, deklasują dedykowane aplikacje językowe. Gotowe rozwiązania okazały się \"ślepą uliczką\" ze względu na sztywne scenariusze i brak elastyczności.\r\n\r\n**Dlaczego ChatGPT wygrywa?**\r\n* **Pełna kontrola:** Kluczem do sukcesu jest prompt, który tworzy idealnie dopasowanego partnera.\r\n* **Naturalna logika:** LLM rozumie kontekst i potrafi płynnie przejść do \"small talku\", zachowując realizm.\r\n* **Skalowalność:** Narzędzie rośnie wraz z umiejętnościami użytkownika – od poziomu A1 do C2.\r\n\r\n## Rekomendacja\r\nZamiast korzystać z ograniczonych aplikacji dedykowanych, rekomendujemy bezpośrednie użycie ChatGPT z wykorzystaniem dobrze skonstuowanych promptów.\n```\n\n### Wiki: Network Analyzer: Wykorzystanie lokalnego modelu do analizy ruchu sieciowego\n```\n## Network Analyzer: Wykorzystanie lokalnego modelu do analizy ruchu sieciowego\r\n\r\n## 1. Cel Projektu\r\nCelem projektu jest stworzenie zautomatyzowanego systemu, który wykorzystuje lokalnie uruchomiony model językowy do analizy ruchu sieciowego w czasie rzeczywistym. System ma na celu identyfikację anomalii, podejrzanych wzorców oraz klasyfikację rodzajów ruchu w sieci bez wysyłania danych do zewnętrznych usług (zapewnienie prywatności i działania offline).\r\n\r\n\r\n## 2. Podsumowanie Wykonawcze (Executive Summary)\r\nProjekt skupił się na weryfikacji możliwości użycia **lokalnych modeli językowych (LLM)** do analizy cyberbezpieczeństwa.\r\n\r\n**Główne osiągnięcia:**\r\n\r\n* Przeprowadzono obszerne testy porównawcze modeli (Gemini 2.5 Pro, ChatGPT 4.1, Llama 3.1 8B, GPT-OSS).\r\n* Udowodniono, że **Context Learning (LC)** z dużą bazą przykładów (10k+) daje lepsze wyniki niż klasyczny prompt engineering.\r\n* Zidentyfikowano **Gemini 2.5 Pro** jako model o najwyższej precyzji i swoistości, a **format JSON** jako najskuteczniejszy format danych wejściowych.\r\n\r\n| Model / Format / Klasa | F1-Score |\r\n| :--- | :--- |\r\n| **WYNIKI DLA KLAS -> GPT-OSS 120b** | |\r\n| Klasa: Exploit (1) | 0.7200 |\r\n| Klasa: Normal (0) | 0.4100 |\r\n| **WYNIKI OGÓLNE MODELI** | |\r\n| ChatGPT + JSON | 0.5902 |\r\n| Gemini + TXT | 0.5831 |\r\n| Gemini + JSON | 0.5558 |\r\n| Gemini + CSV | 0.4772 |\r\n| ChatGPT + CSV | 0.4168 |\r\n| ChatGPT + TXT | 0.4110 |\r\n\r\nProjekt udowodnił, że wykorzystanie **lokalnych modeli LLM** do analizy cyberbezpieczeństwa jest możliwe, ale obarczone istotnymi ograniczeniami technicznymi. Najskuteczniejszą konfiguracją ogólną okazał się model **Gemini 2.5 Pro** zasilany danymi w formacie **JSON**, osiągając wysoką precyzję i minimalizując fałszywe alarmy.\r\n\r\nWykazano jednak znaczące różnice w charakterystyce poszczególnych modeli:\r\n* **Modele komercyjne:** ChatGPT lepiej radzi sobie z atakami wolumetrycznymi (DoS), podczas gdy Gemini dominuje w wykrywaniu rekonesansu.\r\n* **GPT-OSS:** Wykazał silną asymetrię wydajności – jest wysoce skuteczny w identyfikacji ataków (Recall 0.91), lecz generuje nadmierną liczbę fałszywych alarmów dla ruchu normalnego (Recall 0.28).\r\n* **Llama 3.1 8B:** Jako mniejszy model lokalny posłużył do określenia bazowych wymagań, ustępując większym modelom w złożonej analizie kontekstowej, co podkreśla konieczność doboru skali modelu do specyfiki zagrożeń.\r\n\r\n---\r\n\r\n## 3. Kluczowe Wnioski\r\n\r\n### Co zadziałało\r\n1.  **Format Danych:** Format **JSON** bezsprzecznie wygrał z CSV i Plain Text. Modele najlepiej radzą sobie ze strukturą klucz-wartość, co naturalnie grupuje dane i ułatwia identyfikację relacji.\r\n2.  **Model Gemini 2.5 Pro:** Wykazał wyższą precyzję (mniej fałszywych alarmów) i lepszą swoistość (rozpoznawanie ruchu normalnego) niż ChatGPT 4.1.\r\n3.  **Long Context (LC):** Dostarczenie dużej liczby przykładów w kontekście (10k-20k rekordów) drastycznie zwiększa skuteczność (do >99% w niektórych scenariuszach). Mała liczba przykładów (3k-5k) jest niewystarczająca dla Gemini na start, ale model skaluje się lepiej przy większej ilości danych.\r\n\r\n### Wyzwania i Blokery\r\n1.  **Małe Modele Lokalne:** Model **Llama 3.1 8B** okazał się niewystarczający. Generował halucynacje i nie był w stanie utrzymać spójności przy analizie logów. Wymagany jest mocniejszy sprzęt lub większe modele.\r\n2.  **Inżynieria Promptów (\"Bądź bardziej czuły\"):** Próby wymuszenia na modelu wyższej czułości (\"bądź bardzo dokładny\") skutkowały drastycznym spadkiem precyzji i eksplozją fałszywych alarmów (FP), przy minimalnym wzroście wykrywalności ataków.\r\n3.  **Ograniczenia API (External):** Testy zewnętrznych API (NVIDIA, Groq, OpenRouter) napotkały na błędy `413 Payload Too Large` oraz problemy z długością kontekstu (`finish_reason: length`), co utrudnia wsadowe przetwarzanie dużych logów.\r\n4.  **Wykrywalność konkretnych ataków:** Żaden model nie jest w pełni wszechstronny. Oba testowane modele całkowicie pominęły ataki typu Backdoor, Shellcode i Worms.\r\n\r\n---\r\n\r\n## 4. Analiza Techniczna i Wyniki Badań\r\n\r\n## 4.1. Źródła Danych i Narzędzia\r\n\r\nW początkowej fazie projektu przeprowadzono ewaluację narzędzi do manipulacji ruchem sieciowym. Porównano bibliotekę **Scapy** (Python) z oprogramowaniem **Wireshark**.\r\n\r\n* **Scapy** zostało wybrane jako silnik backendowy projektu ze względu na możliwość pełnej automatyzacji, łatwą integrację z językiem Python oraz zdolność do programowego tworzenia i modyfikacji pakietów (aktywny udział w sieci).\r\n* **Wireshark** pozostawiono jako narzędzie pomocnicze do ręcznej weryfikacji (inspekcja *post-mortem*) oraz wizualizacji.\r\n\r\nKluczową decyzją metodologiczną było przejście z prób przechwytywania ruchu \"na żywo\" na pracę z **gotowymi datasetami**. Wykorzystano zbiory danych (m.in. oparte na Kaggle), które posiadały precyzyjnie oznaczone etykiety (`Label: 0` - ruch normalny, `Label: 1` - atak).\r\n\r\nPozwoliło to na:\r\n1.  Wyeliminowanie niepewności co do natury ruchu.\r\n2.  Obliczenie precyzyjnych metryk matematycznych (TP, FP, FN, TN).\r\n3.  Stworzenie powtarzalnego środowiska testowego dla różnych modeli.\r\n\r\n### Dostęp do danych źródłowych\r\n\r\nW celu zapewnienia transparentności, przykładowe fragmenty baz danych wykorzystanych w projekcie (w formatach `.csv`, `.txt`, `.json`) zostały udostępnione w osobnym repozytorium:\r\n\r\n> [ Repozytorium GitHub z przykładowymi danymi](https://github.com/fifol21/Bazy-wykorzystane-w-projekcie_.git)\r\n\r\n### 4.2. Porównanie Modeli i Formatów Danych\r\nW ramach badania przeprowadzono serię eksperymentów (N=10 prób dla każdej konfiguracji), aby wyłonić najskuteczniejszą parę *Model LLM + Format Danych*. Testowano formaty JSON, CSV oraz Plain Text na modelach ChatGPT 4.1 oraz Gemini 2.5 Pro.\r\n\r\n**Tabela wyników zbiorczych (zbiór testowy):**\r\n\r\n| Model / Format       | Accuracy | Precision | Recall (Czułość) | Specificity |\r\n|----------------------|----------|-----------|------------------|-------------|\r\n| ChatGPT + JSON | 73.26% | 81.61%    | 46.22%           | 92.56%      |\r\n| Gemini + JSON | 72.32%   | 83.85% | 41.57%           | 94.28% |\r\n| Gemini + CSV         | 69.24%   | 81.72%    | 33.70%           | 94.62%      |\r\n| Gemini + TXT         | 64.53%   | 57.14%    | 59.52% | 68.12%      |\r\n| ChatGPT + CSV        | 59.36%   | 51.82%    | 34.86%           | 76.86%      |\r\n| ChatGPT + TXT        | 57.90%   | 49.27%    | 35.25%           | 74.08%      |\r\n\r\n**Analiza szczegółowa:**\r\n* **Dominacja formatu JSON:** JSON okazał się bezkonkurencyjny dla obu modeli. Jego hierarchiczna struktura (klucz-wartość) pozwala modelom językowym lepiej \"rozumieć\" kontekst poszczególnych pól (np. `src_ip`, `dst_port`), co drastycznie redukuje halucynacje w porównaniu do \"płaskiego\" CSV.\r\n\r\n![Screenshot_2025-11-26_at_21.02.08](uploads/60c8c238710fec3ae7bfeaccca9f5287/Screenshot_2025-11-26_at_21.02.08.png){width=500 height=388}\r\n\r\n* **Gemini 2.5 Pro (Precyzja):** Model ten wykazał się najwyższą **Swoistością (94.28%)** i **Precyzją (83.85%)**. Oznacza to, że Gemini jest modelem \"ostrożnym\" – bardzo rzadko zgłasza fałszywe alarmy (False Positives). Jeśli Gemini oznacza ramkę jako atak, istnieje bardzo duże prawdopodobieństwo, że jest to prawda.\r\n\r\n![Screenshot_2025-11-26_at_21.01.59](uploads/97eb03efa1e8cdd4d6b76557e2e5cc2f/Screenshot_2025-11-26_at_21.01.59.png){width=500 height=388}\r\n\r\n* **ChatGPT 4.1 (Czułość vs Szum):** ChatGPT osiągnął nieznacznie wyższą ogólną skuteczność (Accuracy), głównie dzięki wyższej czułości na pewne typy ataków (46.22% Recall). Odbyło się to jednak kosztem generowania większej liczby fałszywych alarmów (niższa swoistość).\r\n* **Anomalia Gemini + TXT:** W formacie tekstowym Gemini uzyskał najwyższą czułość ze wszystkich testów (59.52%), ale przy bardzo niskiej precyzji. Sugeruje to, że pozbawiony struktury JSON, model ten ma tendencję do nadinterpretacji danych jako ataków.\r\n\r\n> **Kluczowy Wniosek:** Do zastosowań produkcyjnych rekomendowana jest konfiguracja **Gemini + JSON**. Mimo nieznacznie niższego Recall, drastycznie ogranicza liczbę fałszywych alertów, co jest kluczowe w systemach bezpieczeństwa, aby nie \"zalać\" analityka błędnymi powiadomieniami.\r\n### 4.2.1. Szczegółowe Macierze Pomyłek (Confusion Matrix)\r\nPoniżej przedstawiono zagregowane, surowe dane liczbowe (zsumowane wyniki z testów N=10), które posłużyły do wyliczenia powyższych wskaźników. Obrazują one, jak modele radziły sobie z klasyfikacją poszczególnych rekordów.\r\n\r\n**Legenda:**\r\n* **TP (True Positive):** Poprawnie wykryty normalny ruch\r\n* **FN (False Negative):** Fałszywy alarm (ruch normalny uznany za atak).\r\n* **FP (False Positive):** Niewykryty atak (atak uznany za ruch normalny).\r\n* **TN (True Negative):** Poprawnie zidentyfikowany atak.\r\n\r\n**Gemini 2.5 Pro (Suma próbek: 876,700)**\r\n| Rzeczywistość \\ Predykcja | Przewidziany Atak (Positive) | Przewidziany Normalny (Negative) |\r\n| :--- | :--- | :--- |\r\n| **Rzeczywisty Atak** | **TP:** 169,426 | **FN:** 195,794 |\r\n| **Rzeczywisty Normalny** | **FP:** 82,263 | **TN:** 429,217 |\r\n\r\n\r\n\r\n**ChatGPT 4.1 (Suma próbek: 876,700)**\r\n| Rzeczywistość \\ Predykcja | Przewidziany Atak (Positive) | Przewidziany Normalny (Negative) |\r\n| :--- | :--- | :--- |\r\n| **Rzeczywisty Atak** | **TP:** 141,118 | **FN:** 224,102 |\r\n| **Rzeczywisty Normalny** | **FP:** 99,526 | **TN:** 411,954 |\r\n\r\n\r\n> **Interpretacja Macierzy:**\r\n> Porównując liczby bezwzględne, widać wyraźnie, że **Gemini popełnił o 17,263 mniej fałszywych alarmów (FP)** niż ChatGPT (82k vs 99k), co przy dużej skali ruchu sieciowego jest kluczową różnicą dla operacyjności systemu. Jednocześnie Gemini wykrył o ponad **28,000 więcej rzeczywistych ataków (TP)**.  \r\n\r\n### 4.3. Wpływ wielkości bazy wiedzy (Context Learning)\r\n Zbadano zdolność modeli do uczenia się wzorców *In-Context* (bez fine-tuningu wag). Eksperyment polegał na dostarczeniu modelowi dużej liczby przykładów w prompcie, a następnie zapytaniu o losowe próbki pochodzące z tego samego zbioru (test pamięci/asocjacji).\r\n\r\n| Rozmiar Bazy (rekordy) | ChatGPT 4.1 Accuracy | Gemini 2.5 Pro Accuracy |\r\n| :--- | :--- | :--- |\r\n| 5k | 94.00% | 35.40% |\r\n| 10k | 63.30%  | 92.60% |\r\n| 15k | 99.13% | 88.27% |\r\n| **20k** | **99.95%** | **99.95%** |\r\n\r\n**Szczegółowa interpretacja zachowania modeli:**\r\n1.  **ChatGPT 4.1:**\r\n    * Przy małej bazie (5k) model radzi sobie doskonale.\r\n    * Przy **10k rekordów** następuje załamanie skuteczności (spadek do 63.3%). Wskazuje to na problem z zarządzaniem uwagą (attention mechanism) w średnim zakresie kontekstu – model gubi się w natłoku danych, zanim osiągnie punkt nasycenia.\r\n    * Przy 15k-20k model wraca do pełnej sprawności.\r\n\r\n2.  **Gemini 2.5 Pro:**\r\n    * Przy **5k rekordów** model jest praktycznie bezużyteczny (35.4%). Wskazuje to, że Gemini potrzebuje \"masy krytycznej\" danych, aby poprawnie zmapować schemat logów.\r\n    * Wzrost jest liniowy i stabilny: 10k (92%) -> 20k (99.95%). Model skaluje się przewidywalnie wraz z rosnącą liczbą przykładów.\r\n\r\n3.  **Konwergencja (Wynik 20k):**\r\n    * Przy maksymalnym wypełnieniu okna kontekstowego (20k), oba modele osiągają niemal 100% skuteczności w zadaniu rozpoznawania wzorców, które \"widzą\" w kontekście. Potwierdza to olbrzymi potencjał metod RAG/Long Context w cyberbezpieczeństwie.\r\n### 4.4. Raport Wydajności: GPT-OSS 120b\r\n\r\nPrzeprowadzony na zbalansowanym zbiorze 100 próbek test wykazał, że model osiąga umiarkowaną dokładność ogólną (Accuracy) na poziomie 62%. Wynik ten wynika z drastycznej różnicy w sposobie traktowania obu klas, co obrazuje poniższa tabela:\r\n\r\n| Klasa | Precision | Recall (Czułość) | F1-Score | Interpretacja wyniku |\r\n| :--- | :--- | :--- | :--- | :--- |\r\n| **Normal (0)** | 0.72 | **0.28** | 0.41 | Model pomija aż 72% bezpiecznego ruchu (błędnie uznając go za atak). |\r\n| **Exploit (1)** | 0.60 | **0.91** | 0.72 | Model wykrywa 91% ataków, niemal nie przepuszczając zagrożeń. |\r\n\r\n**Wnioski analityczne:**\r\n Jego największą zaletą jest bardzo wysoki Recall dla klasy Exploit (0.91), co oznacza, że system jest szczelny i skutecznie blokuje ataki (minimalna liczba Fałszywych Negatywów).\r\n\r\nJednakże odbywa się to kosztem użyteczności: krytycznie niski *Recall* dla klasy *Normal* (0.28) wskazuje, że model generuje ogromną liczbę **Fałszywych Pozytywów (False Positives)**. W praktyce oznacza to, że system \"panikuje\", oznaczając większość bezpiecznego ruchu jako złośliwy, co czyni go trudnym do wdrożenia bez dodatkowego dostrojenia (np. zmiany progu decyzyjnego), gdyż zaleje analityków fałszywymi alertami.\r\n\r\n### 4.4.1. Ograniczenia małych modeli lokalnych (Small Language Models)\r\nW przeciwieństwie do dużych modeli komercyjnych, lokalne modele o mniejszej liczbie parametrów (SLM) nie były w stanie skutecznie przetworzyć zadania analizy logów, niezależnie od zastosowanej długości kontekstu. Testy przeprowadzone na modelu **Llama 3.1 8B** wykazały, że model ten nie posiada wystarczających zdolności generalizacji i utrzymania uwagi, aby analizować surowe dane sieciowe w formacie JSON/TXT.\r\n\r\nPoniższa tabela przedstawia wyniki prób wykorzystania modelu Llama 3.1 8B w porównaniu do wymagań zadania:\r\n\r\n| Model | Wielkość Kontekstu (Context Length) | Skuteczność (Accuracy) | Status Wyniku | Główne Problemy |\r\n| :--- | :--- | :--- | :--- | :--- |\r\n| **Llama 3.1 8B** | Mały (~3k rekordów) | **Brak spójnych wyników** | Porażka | Silne halucynacje, wymyślanie ID ramek nieistniejących w pliku źródłowym. |\r\n| **Llama 3.1 8B** | Duży (>10k rekordów) | **Brak spójnych wyników**| Porażka | Model gubił wątek, zwracał losowy tekst lub urywał odpowiedź; brak możliwości przeprowadzenia pełnej walidacji. |\r\n| **Gemini/GPT-4** | Duży (>10k rekordów) | **> 90%** | Sukces | Poprawna identyfikacja wzorców (dla porównania). |\r\n\r\n**Wnioski z analizy małych modeli:**\r\n1.  **Halucynacje:** Przy małym kontekście model generował odpowiedzi sformatowane poprawnie, ale zawierające dane całkowicie zmyślone (numery ID ramek, które nie występowały w logach).\r\n2.  **Brak Skalowalności:** Zwiększenie liczby przykładów w kontekście (co pomogło modelom Gemini i ChatGPT) w przypadku Llamy 8B doprowadziło do całkowitego załamania się procesu wnioskowania (przepełnienie uwagi/pamięci).\r\n3.  **Wymogi Sprzętowe:** Lokalne uruchomienie wnioskowania na tak dużym kontekście dla analizy bezpieczeństwa wymaga infrastruktury znacznie przekraczającej standardowe stacje robocze, co podważa sensowność użycia modeli 8B w scenariuszu \"lightweight\" dla tego konkretnego zastosowania.\r\n\r\n\r\n### 4.5. Specjalizacja w typach ataków i ograniczenia\r\nAnaliza przeprowadzona w Sprincie 06 na zróżnicowanym datasecie ujawniła, że żaden z modeli nie jest uniwersalny. Modele wykazują silną specjalizację w zależności od charakterystyki ataku:\r\n| Kategoria Ataku | Gemini (Poprawnie przewidziane) | ChatGPT (Poprawnie przewidziane) | Wnioski |\r\n| :--- | :--- | :--- | :--- |\r\n| **Analysis** |  (0.57%) |  (0.0%) | Oba modele skrajnie nieskuteczne. |\r\n| **Backdoor** |  (0.0%) |  (0.0%) | **Całkowita porażka** obu modeli. |\r\n| **DoS** |  (1.17%) |  (73.02%) | **Zdecydowana wygrana ChatGPT.** Gemini jest praktycznie ślepy na ataki DoS. |\r\n| **Exploits** |  (0.22%) |  (5.04%) | Oba modele bardzo słabe, ChatGPT minimalnie lepszy. |\r\n| **Fuzzers** |  (3.36%) |  (1.0%) | Oba modele bardzo słabe, Gemini minimalnie lepszy. |\r\n| **Reconnaissance** |  (42.04%) |  (2.51%) | **Zdecydowana wygrana Gemini.** To jedyna kategoria z przyzwoitym wynikiem dla Gemini. |\r\n| **Shellcode** |  (0.0%) | (0.0%) | **Całkowita porażka** obu modeli. |\r\n| **Worms** |  (0.0%) | (0.0%) | **Całkowita porażka** obu modeli. |\r\n\r\n\r\n* **Ataki DoS (Denial of Service):**\r\n    * **ChatGPT:** 73.02% wykrywalności. Model ten świetnie radzi sobie z wykrywaniem wolumetrycznych anomalii i powtarzalnych wzorców charakterystycznych dla DoS.\r\n    * **Gemini:** ~0% wykrywalności. Model traktował zalew pakietów jako szum lub ruch normalny.\r\n\r\n* **Rekonesans (Reconnaissance / Skanowanie portów):**\r\n    * **Gemini:** 42.04% wykrywalności. Gemini znacznie lepiej rozumie sekwencje zdarzeń i subtelne próby mapowania sieci.\r\n    * **ChatGPT:** 2.51% wykrywalności. Model ten często ignorował pojedyncze pakiety sondujące.\r\n\r\n* **Fuzzers:**\r\n    * Oba modele wypadły słabo, z lekką przewagą Gemini (3.36% vs 1.0%). Anomalie w polach danych (payload) są trudne do wykrycia bez specjalistycznego preprocessingu.\r\n\r\n* **Backdoor / Worms / Shellcode:**\r\n    * **0% wykrywalności.** Jest to krytyczne ograniczenie obecnego podejścia. Ataki te często ukryte są głęboko w payloadzie pakietu (często zaszyfrowanym lub zakodowanym), co przy konwersji do uproszczonego JSON-a staje się niewidoczne dla LLM.\r\n\r\n**Wniosek końcowy:** Ze względu na rozbieżne specjalizacje, najlepszym rozwiązaniem architektonicznym wydaje się **podejście hybrydowe** (router kierujący ruch podejrzany o wolumetrię do modelu klasy GPT, a ruch skanujący do modelu klasy Gemini) lub zastosowanie wyspecjalizowanych agentów.\r\n\r\n## 5. Decyzje Architektoniczne\r\n1.  **Stos Technologiczny:**\r\n    * **Backend:** Python (przetwarzanie danych).\r\n    * **Dane:** Historyczne, oznaczone zbiory danych (Ground Truth) zamiast przechwytywania na żywo.\r\n    * **LLM Serving:** Lokalne instancje (Ollama) ze względu na prywatność i brak limitów przesyłu danych.\r\n2.  **Metoda Uczenia (In-Context Learning):**\r\n    * Zrezygnowano z klasycznego *fine-tuningu* małych modeli (np. Llama 3 8B), ponieważ generowały one zbyt wiele halucynacji i nie potrafiły utrzymać spójności logicznej.\r\n    * Zastosowano metodę **RAG/Long Context** na większych modelach, dostarczając im obszerne fragmenty bazy wiedzy w oknie kontekstowym. Podejście to dało znacznie lepsze wyniki przy dynamicznie zmieniających się wektorach ataków.\r\n3.  **Odrzucenie Zewnętrznych API (Cloud):**\r\n    * W toku prac  przetestowano zewnętrzne API: **Groq (GPT-OSS), NVIDIA API oraz OpenRouter**. Rozwiązania te zostały odrzucone z powodów technicznych: błędy `413 Payload Too Large` przy próbie przesłania dużej liczby logów oraz problemy z urywaniem odpowiedzi (`finish_reason: length`) przy skomplikowanych analizach.\r\n4.  **Protokół Komunikacji:**\r\n    * Wykorzystanie formatu **JSON** do reprezentacji ramek sieciowych. Format ten zapewnił najlepszą czytelność dla modeli LLM i zminimalizował ryzyko błędnej interpretacji danych w porównaniu do CSV.\r\n\r\n---\r\n\r\n## 6. Źródło\r\n\r\n**Link do bazy danych w opraciu o którą  był wykonywany projekt**\r\n> [ Baza danych - źródło ](https://research.unsw.edu.au/projects/unsw-nb15-dataset?fbclid=IwZXh0bgNhZW0CMTAAYnJpZBExd3lKdDdHeG9vb2plbFZlUHNydGMGYXBwX2lkEDIyMjAzOTE3ODgyMDA4OTIAAR4Qr9Rngkk-jwKv9AHT7ye8wV6Z2nTnq-L-GMZVBvi7opCxJaE2m0MfuMoWrw_aem_Zt-NHiD6G-MDC6RsvEO-Jw)\r\n\r\n\r\n\n```\n\n### Wiki: Ożywianie plakatów filmowych używając AI\n```\n# Abstrakt\r\n\r\nW projekcie „Ożywianie plakatów filmowych używając AI” zbadaliśmy możliwości wykorzystania nowoczesnych narzędzi sztucznej inteligencji do przekształcania statycznych plakatów filmowych w dynamiczne, zapętlone animacje. Przeanalizowaliśmy dostępne platformy AI, wybraliśmy najbardziej odpowiednie narzędzia, a następnie stworzyliśmy krótkie animacje oparte na wytypowanych plakatach filmowych. Efektem naszej pracy są trójwymiarowe wizualizacje z pełnym udźwiękowieniem, które mogą znaleźć zastosowanie w marketingu filmowym oraz interaktywnych ekspozycjach.\r\n\r\n# Plan działania\r\n\r\nW projekcie \"Ożywianie plakatów filmowych używając AI\" wykonaliśmy następujące kroki:\r\n\r\n* Przeanalizowaliśmy dostępne narzędzia AI, które mogą posłużyć do ożywiania plakatów filmowych.\r\n* Stworzyliśmy bazę plakatów, z których wytypowaliśmy 3 najlepiej nadające się do projektu.\r\n* Stworzyliśmy za pomocą AI krótkie animowane filmiki wykorzystując wcześniej wytypowane plakaty.\r\n* Zapętliliśmy filmiki, oraz dodaliśmy do nich wygenerowany przez AI dźwięk.\r\n\r\n# Przegląd dostępnych narzędzi\r\n\r\nW ramach projektu przeanalizowaliśmy dostępne narzędzia AI, które mogą posłużyć do ożywiania plakatów filmowych. Oto wybrane platformy:\r\n\r\n* D-ID: Specjalizuje się w ożywianiu zdjęć, oferując animację twarzy i synchronizację ruchu warg z tekstem lub dźwiękiem. Popularne w marketingu i do tworzenia interaktywnych treści. Darmowy dostęp: do 5 minut filmików. Płatny dostęp z 3 progami z elastyczną liczbą kredytów.\r\n\r\n  ![1.png](uploads/9b2e2231330a6b0101c44a2ff00d8a1f/1.png){width=\"600\" height=\"296\"}\r\n* RunwayML: Platforma wykorzystująca AI do animacji i manipulacji obrazów/wideo. Pozwala tworzyć sekwencje wideo na podstawie obrazów i edytować projekty w czasie rzeczywistym. Darmowa wersja: 125 kredytów (25 sekund Gen-2 lub 8 sekund Gen-1). Płatne wersje: 12, 28 lub 76 dolarów miesięcznie. ![2](uploads/3900a022f29ce7f9ec652e381da5b46c/2.png){width=\"708\" height=\"328\"}\r\n* EbSynth: Umożliwia przekształcanie stylów obrazów na ruch wideo, np. ożywiając obrazy w artystyczny sposób. Cenione w branży animacji i sztuki. Darmowe (wersja beta). ![3](uploads/6d34b35e5455ba21b401ad7bc7007353/3.png){width=\"691\" height=\"341\"}\r\n* Kaiber: Generuje krótkie filmy na podstawie obrazów, integrując elementy ruchu i muzyki. Idealne do tworzenia wizualizacji wideo z unikalnymi efektami stylizacyjnymi. Darmowa wersja: 200 kredytów (1 kredyt/sekunda filmu). Wersje płatne: 15 dolarów miesięcznie, 120 dolarów rocznie lub pakiety kredytów. ![4](uploads/9ca4aa26e919a37b47ee7be00a61d69f/4.png){width=\"702\" height=\"344\"}\r\n* Pika: Platforma do tworzenia animowanych treści z tekstu, obrazów i wideo. Oferuje funkcje text-to-video, image-to-video, edycję nagrań, synchronizację ruchu warg i rozszerzanie obrazu. Darmowy plan: 250 kredytów (150 dla Pika 1.5), 10 kredytów = 3 sekundy filmu. Płatne wersje: 10, 35 i 70 dolarów miesięcznie. ![5](uploads/7d94500d15c98d2081d07a31a489ae16/5.png){width=\"719\" height=\"371\"}\r\n\r\n# Baza plakatów\r\n\r\nUtworzyliśmy bazę plakatów, które posłużą nam do projektu. Baza znajduje się pod tym linkiem: https://drive.google.com/drive/folders/10MELhNbSEg4f_ANu_FG-AGOHWRdND-3P?usp=sharing. Są tam plakaty zarówno z napisami jak i bez. Następnie wytypowaliśmy 3 różne plakaty, na których będziemy robić próby:\r\n\r\n![rain-man.jpg](uploads/b683f073bb795f42f10ac166ca6dc6b5/rain-man.jpg){width=\"256\" height=\"389\"}![05-backdraft.jpg](uploads/4a3c4ea2aa14ac4762dbeadb104ed5a2/05-backdraft.jpg){width=\"257\" height=\"389\"}![20-the-dark-knight.jpg](uploads/0b8e46144df7ad98ca8526752876bf64/20-the-dark-knight.jpg){width=\"259\" height=\"383\"}\r\n\r\n# Tworzenie filmików\r\n\r\nWykorzystując model Gen-3 Alpha Turbo na stronie Runway, stworzyliśmy krótkie animacje oparte na wcześniej przedstawionych plakatach. Dla każdego plakatu utworzyliśmy dwie wersje, w jednej to my tworzyliśmy prompt, a w drugiej prosiliśmy ChatGPT o wygenerowanie odpowiedniego dla plakatu promptu.\r\n\r\n### _Batman: Dark Knight_\r\n\r\n1) Nasz prompt: \"make the background come alive, make the flames burn, the fog move. Make Batman look back at the building behind him\"\r\n\r\n![Gen-2_3699362090_make_the_background__20-the-dark-knightj_M_5.mp4](uploads/d59e853ff21cf8a835f2d10286ed87df/Gen-2_3699362090_make_the_background__20-the-dark-knightj_M_5.mp4){width=400 height=500}\r\n\r\n2) Prompt od ChatGPT: \"Make the flames in the bat symbol flicker subtly with embers falling. Add gentle swirling motion to the smoke in the foreground. Batman's cape should shift slightly, as if in the wind. Debris drifts down slowly, and faint light pulses from the flames, casting soft shadows. Keep it dark and dramatic\"\r\n\r\n![Gen-2_3254049551_Make_the_flames_in_t_20-the-dark-knightj_M_5.mp4](uploads/c1db524a0f2415dc064a9b3a0d50d4f3/Gen-2_3254049551_Make_the_flames_in_t_20-the-dark-knightj_M_5.mp4){width=400 height=500}\r\n\r\n### _Backdraft_\r\n\r\n1) Nasz prompt: \"Make flames and fire surrounding a doorway, with a human walking through\"\r\n\r\n![Gen-3_Alpha_Turbo_1779412832_Make_flames_and_fire_05-backdraft_2jpg_M_5](uploads/cb8dd802732ddf5aa2d0eec4045276e4/Gen-3_Alpha_Turbo_1779412832_Make_flames_and_fire_05-backdraft_2jpg_M_5.mp4){width=400 height=500}\r\n\r\n2) Prompt od ChatGPT: \"Generate a realistic animation of a firefighter walking confidently through a stationary camera shot of a doorway engulfed in flames. The flames should move dynamically, with natural flickering and bursts of fire. The firefighter should walk directly towards the camera, with their silhouette illuminated by the glowing fire. The camera remains completely still, creating a steady and cinematic perspective that emphasizes the intensity of the scene\"\r\n\r\n![Gen-3_Alpha_Turbo_499215721_Generate_a_realistic_05-backdraft_1jpg_M_5__1\\_](uploads/719cc613d1f27c828b4691ffd474f529/Gen-3_Alpha_Turbo_499215721_Generate_a_realistic_05-backdraft_1jpg_M_5__1_.mp4){width=400 height=500}\r\n\r\n### _Rain Man_\r\n\r\n1) Nasz prompt: \"picture shows two men walking in the park. Make them move, make them move their heads a little, make them talk to each other for a moment, then make their heads return to normal, and keep both men in the centre of the screen\"\r\n\r\n![Gen-3_Alpha_Turbo_1405392839_Te_picture_shows_two_rain-manjpg_M_5](uploads/8324f76d6833f2afa00a95916aa2d706/Gen-3_Alpha_Turbo_1405392839_Te_picture_shows_two_rain-manjpg_M_5.mp4){width=400 height=500}\r\n\r\n2) Prompt od ChatGPT: \"Create a realistic animation of two male characters walking along a tree-lined pathway. The man on the left wears sunglasses, a dark blazer, and light trousers, carrying a bag slung over his shoulder. The man on the right wears a beige jacket and gray pants, walking calmly with his hands free. Animate their walking motions so that they stride naturally and smoothly down the pathway. Include subtle environmental details such as the gentle sway of trees in the background and shadows shifting with the characters' movements. Keep the mood casual and reflective, as if they are having a quiet moment outdoors.\"\r\n\r\n![Gen-3_Alpha_Turbo_133258959_Create_a_realistic_a_rain-man_1jpg_M_5](uploads/d054cbafa4e89deecfb6d7299da817ca/Gen-3_Alpha_Turbo_133258959_Create_a_realistic_a_rain-man_1jpg_M_5.mp4){width=400 height=500}\r\n\r\n# Zapętlenie filmów i udźwiękowienie\r\n\r\nDocelowo chcemy aby te plakaty mogły być wyświetlane w kinach, więc najlepiej jeżeli nie byłoby widocznego cięcia po zakończeniu filmiku i rozpoczęciu go od nowa. Postanowiliśmy więc utworzyć nowe filmiki, tym razem zapętlone. Wykorzystaliśmy do tego to samo narzędzie co wcześniej, jednak dodaliśmy warunek że ostatnia klatka ma być taka sama jak pierwsza.\r\n\r\n### _Rainman_\r\n\r\nPrompt: \"The picture shows two men walking in the park. Make them move, make them move their heads a little, make them talk to each other for a moment, then make their heads return to normal, and keep both men in the centre of the screen.\"\r\n\r\n![Rain_man_petla.mp4](uploads/42128c5347ed13e6b3ee2d2a707c1d47/Rain_man_petla.mp4){width=400 height=500}\r\n\r\n### _Backdraft_\r\n\r\nPrompt: \"A dynamic scene of a firefighter surrounded by roaring flames. The firefighter moves energetically, shifting their entire body weight smoothly from side to side. They lean slightly to the left, then to the right, as if reacting to the intense heat or scanning their surroundings. Their head moves naturally in sync with their body, turning slightly left and right while tilting subtly up or down. The firefighter's arms adjust fluidly for balance, and their stance shifts as one foot moves slightly outward, creating a natural, dynamic flow. The flames burn fiercely, flickering and swirling chaotically, with occasional bursts of embers flying into the air. Shadows cast by the fire shift dynamically across the firefighter's figure. Ensure the entire scene loops seamlessly, with all movements and fire animations transitioning smoothly for an endless animation\"\r\n\r\n![Gen-3_Alpha_Turbo_499715641_A_firefighter_standi_05-backdraft_2jpg_M_5.mp4](uploads/3e897530406b048513dcb2c0220b3c8d/Gen-3_Alpha_Turbo_499715641_A_firefighter_standi_05-backdraft_2jpg_M_5.mp4){width=400 height=500}\r\n\r\n### _The Dark Knight_\r\n\r\nprompt: \"Create a dynamic, seamless animation based on this image of a superhero standing in front of a building with a fiery symbol in the background. In the animation: The superhero (man in black armor) subtly shifts his body weight as if adjusting his stance. His head turns slowly to the left, holds briefly, then smoothly returns to the center. The fiery bat-shaped symbol in the building burns intensely, with the flames flickering naturally and embers flying upward. Dust and small debris float through the air, moving naturally to create a sense of motion and atmosphere. Shadows from the flames shift across the superhero and the environment, enhancing the dramatic lighting. Ensure the animation loops seamlessly, with all movements, flames, and environmental details transitioning smoothly into an endless cycle.\"\r\n\r\n![Gen-3_Alpha_Turbo_2576423883_Make_the_flames_in_t_20-the-dark-knightj_M_5.mp4](uploads/0dac63be06837d28d9958471c14b948a/Gen-3_Alpha_Turbo_2576423883_Make_the_flames_in_t_20-the-dark-knightj_M_5.mp4){width=400 height=500}\r\n\r\nNastępnie do utworzonych zapętlonych filmików dodaliśmy dźwięki wygenerowane na podstawie podanych promptów przez AI. Użyliśmy do tego tej strony: https://elevenlabs.io/app/sound-effects/generate\r\n\r\nDo wygenerowania promptów do strony https://elevenlabs.io/app/sound-effects/generate użyliśmy Chata GPT. Strona elevenlabs generuje 4 różne ścieżki dźwiękowe na podstawie prompta. Do każdego z plakatów wybraliśmy według nas najlepszy. Oto co wymyślił Chat GPT na podstawie plakatów:\r\n\r\nDźwięk do _**Rainman**_:\r\n\r\nprompt: \"Soft bird chirping, gentle rustling of leaves, distant footsteps on a park path, and a light breeze.\"\r\n\r\nWygenerowana ścieżka dźwiękowa:\r\n\r\n![1](uploads/b3ebdb3879e21e328ae1b630bd89387c/1.mp3)\r\n\r\nDźwięk do _**Backdraft**_:  \r\n\r\nprompt: \"Design an intense soundscape of roaring fire, crackling wood, and distant collapsing debris. Add subtle echoes of heavy footsteps and the low rumble of heat to evoke the chaos of a massive blaze.\"\r\n\r\nWygenerowana ścieżka dźwiękowa:\r\n\r\n![2](uploads/a1d8747e7984e5739ff0b1c1ed52f0cd/2.mp3)\r\n\r\nDźwięk do _**The Dark Knight**_:\r\n\r\nprompt: \"Create a looping soundscape with deep rumbles, swirling dust, eerie wind, crackling flames, and distant explosions. Add metallic clinks, the faint rustle of a cape, low strings, and a pulsing rhythm. Blend a soft choir to evoke mystery and seamlessly loop back\"\r\n\r\nWygenerowana ścieżka dźwiękowa:\r\n\r\n![3](uploads/b43924c02eefc71fa911d78fc25dddad/3.mp3)\r\n\r\n# Końcowy rezultat\r\n\r\nAby uzyskać finałowy rezultat, czyli zapętlony filmik z dźwiękiem, wykorzystaliśmy darmowy program do pobrania -> Shotcut. Rezultaty znajdują się pod tym linkiem: https://drive.google.com/drive/folders/1AsmnvgQ-SyfZ6J-6dwxmqfJwPUa8OHsF?usp=sharing\r\n\r\n![image](uploads/174d0f6b9e7970da4dcd8bf2ec800e60/image.png)\r\n\r\n# Podsumowanie\r\n\r\nW ramach projektu udało się skutecznie przekształcić statyczne plakaty filmowe w animacje wykorzystując nowoczesne narzędzia AI, takie jak RunwayML. Przeanalizowaliśmy potencjał wybranych platform, opracowaliśmy odpowiednie prompty do generowania ruchu i dźwięku, a także zadbaliśmy o techniczne aspekty płynnego zapętlenia animacji. Finalne rezultaty zostały wzbogacone o odpowiednie ścieżki dźwiękowe, które podkreślają atmosferę każdej animacji. \r\nPo pewnych poprawkach, m.in. używając płatnych wersji premium, możliwe jest uzyskanie odpowiedniej animacji, gotowej do wprowadzenia do kin czy też jako elementu promocji filmów.\n```\n\n### Wiki: Phishussy: kreator spersonalizowanych maili\n```\n# Cel\r\n\r\nProjekt ma na celu wykorzystanie modelu do generowania spersonalizowanych wiadomości mailowych na podstawie danych zebranych w social mediach oraz ocenę wiarygodności wygenerowanych materiałów.\r\n\r\n# Metoda działania\r\n\r\n* Scraping danych z social mediów (np. Facebook, LinkedIn)\r\n* Przygotowanie odpowiedniej struktury maila\r\n* Wygenerowanie maila na podstawie zebranych danych.\r\n* Testowanie na wcześniej przygotowanych fake-kontach\r\n\r\n# Początkowy research\r\n\r\nIstnieją narzędzia, które działają w podobny sposób do naszych założeń:\r\n\r\n* **Persado**: Jest to platforma marketingowa wykorzystująca sztuczną inteligencję do tworzenia treści, które maksymalizują zaangażowanie klientów. Koncentruje się na tym, aby język marketingowy był jak najbardziej skuteczny, w oparciu o dane i psychologię emocji.\r\n* **Phrasee**: Jest to AI do tworzenia tekstów marketingowych, głównie dla e-maili, reklam cyfrowych i komunikacji w social media. Phrasee generuje treści w spójnym tonie marki, optymalizując je pod kątem zaangażowania odbiorców.\r\n\r\nNasz projekt jest dużo bliższy do Persado, ponieważ checemy skupić się na konkretnej osobie docelowej, a nie na tym, aby treści były spójne z jakąś konkretną marką na rynku.\r\n\r\n### Research podejście agentowe: co to jest?\r\n\r\nPodejście agentowe to sposób na otworzenie oprogramowania w oparciu o autonomiczne jednostki zwane agentami. Agenci to nic innego jak LLMy ( Large Language Models ) które są w stanie rozumieć polecenia ( system prompty + user input ) i zwracać oczekiwany output. Oprogramowanie agentowe możemy tworzyć w oparciu o pojedyńczego agenta, który przetwarza polecenie usera i za pomocą narzędzi może wysyłać maile/zapisywać dane do bazy danych. Takie rozwiązanie działa, ale czasami agent ma za dużo na głowie i nie zwraca oczekiwanych wyników.\r\n\r\nW praktyce najlepiej wypadają workflowy agentowe. Polegają one na tym, że agenci są połączeni między sobą za pomocą kodu (np w pythonie) i output jednego staje sie inputem do drugiego. Umożliwia to nam lepsze wykorzystanie LLMów do konkretnych tasków za które odpowiadają. Np. jeden agent odpowiada za szukanie danych po facebooku, które przekazuje agentowi piszącemu maile\r\n\r\n### Research frameworków\r\n\r\nFrameworki są naszym \"glue kodem\" łączącym LLMy ( agentów ) w workflowy. Nie musimy pisać boilerplate kodu np. do przekazania do agenta narzędzi, czy komunikacji między nimi. Poniżej wybrane najbardziej popularne frameworki agentowe w pythonie:\r\n\r\n**Langchain (Langgraph)** - open sourcowy ekosystem dla zarządzania i budowania workflowów agentowych.\r\n\r\nZalety:\r\n\r\n- nie musimy pisac boilerplate codu\r\n- nie jest llm-provider-specific\r\n- fajny\r\n\r\nWady:\r\n\r\n- ciężko się go nauczyć - dużo pojęć wykorzystywanych tylko w tym ekosystemie ( poza nim sie nie przydadzą )\r\n- ciężko debugować - przez duży overhead kodu jest eśmy troche bardziej high level od komunikacji z LLM za pomocą zwykłych requestów, czasami ciężko znaleść błąd przy dużych workflowach\r\n\r\n**Open AI Client ( Open AI Agents SDK )**\r\n\r\nZalety:\r\n\r\n- Mniejsza ilość pojęć i są one bardziej ogólne które są wykorzystywane wszędzie poza langgraphem\r\n- Łatwiej debugować niż\r\n- Dobra integracja z modelami OAI które działają bardzo dobrze\r\n\r\nWady:\r\n\r\n- Duży nacisk na korzystanie z modeli open ai ( można to obejść ale troche kodu zajmuje )\r\n\r\n**CrewAI** - bardziej wersja no code z outputem do terminala - nie ma zastosowania w aplikacjach webowych\r\n\r\n## **Przykładowe role agentów AI dla naszego projektu**\r\n\r\n### **Czym są agenci AI ?**\r\n\r\nto podmioty oprogramowania zaprojektowane aby samodzielnie obserwować środowisko, podejmować decyzje i wykonywać zadania dążąc do osiągnięcia określonego celu. Każdy agent AI ma zwykle cztery podstawowe komponenty :\r\n\r\n* percepcja (odbiera dane z otoczenia) - np. odczytuje dane z Facebook\r\n* rozumowanie (analizuje dane, tworzy wnioski) - np. Analizuje profil na Facebook\r\n* działanie (wykonuje określone kroki w środowisku) - np. Generuje i wysyła wiadomość mail\r\n* uczenie się (ulepsza swoje decyzje na podstawie tego co już zrobił) - np. uczy się jakie maile mają największa skuteczność\r\n\r\n### Cele funkcjonalne agentów w naszym projekcie:\r\n\r\n1. **Agent zbierania danych**\r\n   * gromadzi metadane i treści z profili publicznych, postów i publicznych komentarzy\r\n   * znajduje źródło, datę, czas i kontekst\r\n2. **Agent przetwarzania**\r\n   * wyciąga interesujące nas cechy: zainteresowania, stanowisko, doświadczenie, ogólną lokalizacje, język, aktywność, obserwowane strony i z jakimi rzeczami dana jednostka najczęściej wchodzi w interakcję\r\n   * normalizacja formatu danych, wykrywanie języka i usuwanie treści wrażliwych\r\n3. **Agent tworzący strukturę maila**\r\n   * definiuje komponenty maila: temat, wstępny podgląd treści, nagłówek (z możliwością personalizacji), wprowadzenie( 1-2 zdania), część z zasadniczą zawartością (spersonalizowana oferta), wezwanie do działania (zachęta aby odbiorca coś zrobił) oraz stopkę zawierająca dane kontaktowe.\r\n4. **Agent generujący treść**\r\n   * generuje treść maila na podstawie przetworzonych cech i wypracowanego szablonu\r\n   * stosuje ograniczenia: brak próśb o dane wrażliwe, manipulujących technik i jasne oznaczenie że mail został wysłany w ramach badań i nie ma na celu oszustwa lub promocji jakiś treści.\r\n   * za każdym wygenerowanym mailem: przypisanie poziomu pewności i powodów doboru fraz ( dlaczego napisał o piłce nożnej a nie o kasynie online)\r\n5. **Agent oceny wiarygodności**\r\n   * jego celem jest ocenić na ile wygenerowany materiał jest oparty na rzetelnych źródłach i czy sam mail nie wprowadza w błąd\r\n   * źródłowy poziom zaufania: reputacja domeny/serwisu, wiek konta\r\n   * Cross-validation: czy kluczowe fakty (np. wiek, stanowisko, przybliżona lokalizacja) pojawiają się na więcej niż 2 niezależnych źródłach publicznych\r\n   * Semantyczna spójność: czy wygenerowane maile są logiczne i spójne z profilami? (np. nie będziemy pisać do studenta o ofertach domów dla starców w okolicy)\r\n   * Styl i język: określić czy dany styl i język odpowiada odbiorcy naszego maila - inaczej będziemy zwracać się do osób z rożnych grup społecznych\r\n   * Human-in-the-loop: przedstawia raport dla moderatora z linkami do źródeł, możliwość sugestii zmian lub odrzucenia.\r\n   * Wynik + kategorie ryzyka (low/medium/high) + krótka narracja (np. profil potwierdzony w 3 miejscach ale brak niedawnej aktywności - zalecenie weryfikacji)\r\n6. **Agent wysyłający maila**\r\n   * dostęp do serwera SMPT\r\n   * będzie w stanie wysłać maila\r\n\r\nIstnieją narzędzia, które umożliwiają **URL -\\> PNG**. Takimi narzędziami są np.:\r\n\r\n* **APIFlash**(https://apiflash.com/) - Pozwala ono na wytworzenie obrazu w kilku formatach, lecz niestety nie obsługuje automatycznej autoryzacji\r\n* **URLBox**(https://urlbox.com/) - Zapewnia większą kontrole oraz GUI. Działa znacznie lepiej przy pobieraniu całej strony\r\n\r\nObie opcje zawierają darmowe plany, które umożliwiają mocno ograniczoną ilość zapytań.\r\n\r\nCo do autoryzacji na portalach, z których chcemy zbierać dane, blokują one zakładanie kont na adresy kojarzone z popularnymi serwisami do tymczasowych maili.\r\n\r\n# Review agentów\r\n\r\n---\r\n\r\n## 1. **Agent przetwarzania**\r\n\r\n**Zadanie:**\\\r\nPrzekształca zescrapowane dane w bardziej przejrzysty, usystematyzowany sposób.\r\n\r\n**Przykład:**\\\r\n[Microsoft AI Builder – Entity Extraction](https://learn.microsoft.com/pl-pl/ai-builder/prebuilt-entity-extraction)\r\n\r\n**Możliwości:**\r\n\r\n* Gotowy model do wyciągania i klasyfikowania encji z tekstu.\r\n* Wykrywa kluczowe elementy jak imię, firma, lokalizacja, stanowisko.\r\n* Integruje się z Power Automate i innymi narzędziami Microsoft.\r\n\r\n---\r\n\r\n## 2. **Agent profilowania**\r\n\r\n**Zadanie:**\\\r\nNa podstawie zwróconych danych LLM tworzy profil osobowości oraz przykładowe treści, które mogą przykuć uwagę użytkownika.\r\n\r\n**Możliwości:**\r\n\r\n* Analiza cech osobowości, stylu komunikacji i zainteresowań.\r\n* Generowanie wstępnych opisów lub rekomendacji treści dopasowanych do użytkownika.\r\n* Można użyć modeli OpenAI GPT-4 lub Personality Insights z Hugging Face.\r\n\r\n---\r\n\r\n## 3. **Agent tworzący maila**\r\n\r\n**Zadanie:**\\\r\nPrzekształca treści wygenerowane przez agenta profilującego w gotowy e-mail (temat, treść, stopka).\r\n\r\n**Przykład:**\\\r\n[LLMChain – tutorial na YouTube](https://www.youtube.com/watch?v=p4OFECyQVlw&t=22s)\r\n\r\n**Możliwości:**\r\n\r\n* Tworzenie poprawnej struktury maila.\r\n* Automatyczne generowanie nagłówków i personalizowanej treści.\r\n* Możliwość integracji z szablonami HTML lub narzędziami mailingowymi.\r\n\r\n---\r\n\r\n## 4. **Agent oceniający**\r\n\r\n**Zadanie:**\\\r\nOcenia jakość i wiarygodność stworzonego e-maila.\r\n\r\n**Przykład:**\\\r\n[OpenEvals – tutorial na YouTube](https://www.youtube.com/watch?v=J-F30jRyhoA)\r\n\r\n**Możliwości:**\r\n\r\n* Ocena, na ile tekst brzmi naturalnie (problem z subiektywnością).\r\n* Wykrywanie tzw. _halucynacji modelu_ (czy AI wymyśla nieprawdziwe informacje).\r\n* Weryfikacja spójności i stylu wiadomości.\r\n\r\n# Review Agentów V2\r\n\r\n### Agent Zarządzający\r\n\r\n* rozmawia z klientem, poprzez interfejs czatowy. Klient dobrowolnie podaje mu dane i emaila, jeżeli nie poda emaila to agent będzie się go domagał póki go nie otrzyma.\r\n* zadaje wiele pytań do agenta pozyskiwania danych - ( wielokrotnie używa agenta pozyskiwania danych do momentu aż zdobędzie wystarczająco dużo informacji)\r\n* Wyjście: Agent przesyła zdobyty mail i dane do agenta profilowania\r\n\r\n### Agent pozyskiwania i przetwarzania danych\r\n\r\n* TOOLS: - agent jest zdolny do samodzielnego scrapowania infromacji z stron za pomocą wcześniej napisanego scrapera.\r\n* Wejście: informacje od agenta zarządzającego - co chce znaleźć i na jakiej stronie\r\n* Działanie: Scrapuje dane z mediów społecznościowych (np. Instagram, Facebook) – zawierające informacje o użytkowniku: stanowisko, zainteresowania, aktywność, wiek, adres email(jeśli się da), przybliżona lokalizacja itp.\r\n* Dodatkowo oczyszcza dane z duplikatów i błędów. Normalizuje język i format informacji. Wyodrębnia kluczowe informacje (firma, zainteresowanie, branża - te z napisanych powyżej jeszcze dokładnie zdecydujemy).\r\n* Wyjście: Ustrukturyzowany profil użytkownika gotowy do analizy przez agenta zarządzającego.\r\n\r\n### Agent profilowania\r\n\r\n* Wejście: Dane ustrukturyzowane przez agenta zarządzającego.\r\n\r\n  Działanie: Analizuje dane użytkownika i określa jego cechy osobowości, preferencje i zainteresowania (chcemy uzyskać jak najbardziej pasujący styl wypowiedzi oraz zakres poruszanych treści). Generuje tzw. profil komunikacyjny — czyli opis tego, jakie treści i ton wypowiedzi najlepiej do niego pasują. Tworzy wstępne pomysły na treść lub tematy(ogólniki np. motoryzacja lub muzyka klasyczna), które mogą zainteresować użytkownika.\r\n* Wyjście: Profil psycholingwistyczny użytkownika + propozycje treści dopasowanych do jego stylu i zainteresowań.\r\n\r\n### Agent tworzący maila\r\n\r\n* Wejście: Profil użytkownika i rekomendowane treści od agenta profilującego. Działanie:\r\n* Generuje kompletny, spersonalizowany e-mail. Zachowuje poprawną strukturę wiadomości:\r\n\r\n  Temat\r\n\r\n  Wstęp / nagłówek\r\n\r\n  Główna treść (dopasowana do profilu odbiorcy)\r\n\r\n  Stopka\r\n* Dostosowuje język i ton do profilu użytkownika.\r\n* Wyjście: Gotowa treść wiadomości e-mail w formacie tekstowym lub HTML.\r\n\r\n### Agent oceniający\r\n\r\n* Wejście: Wygenerowana wiadomość e-mail. Działanie:\r\n* Analizuje jakość i naturalność tekstu (czy brzmi „ludzko”). Sprawdza, czy model nie wygenerował błędnych informacji (tzw. halucynacji). Weryfikuje spójność wiadomości z profilem użytkownika. Przydziela ocenę jakości (np. Low / Medium / High) oraz generuje krótki raport oceny.\r\n* Wyjście: Raport oceny zawierający: Poziom wiarygodności i naturalności treści, Informację o ewentualnych błędach lub halucynacjach, Sugestie poprawek lub doprecyzowań - tutaj human in the loop może przekazać nam mail do sprawdzenia.\r\n\r\n### Agent wysyłający mail\r\n\r\n* Wejście : gotowy do wysłania mail z potwierdzoną pasującą do użytkownika treścią\r\n* Ma dostęp do maila (serwer SMTP), otrzymuje adres na który ma wysłać przygotowaną wiadomość, wkleja całą przygotowaną treść i wysyła mail.\r\n* TOOL: wysyłanie maila\r\n* Wyjście: odpowiedź do użytkownika który zainicjował całe działanie (tego który zapytał agenta zarządzającego)\r\n\r\n# System prompt\r\n\r\nsystem_prompt = ''' You are an intelligent Client Data Manager Agent responsible for managing the client onboarding and data collection process. Your task is to communicate with a client in a natural, friendly way and gather enough information to build a complete client profile using available scraping tools.\r\n\r\n```\r\nYour Objectives:\r\n\r\n -Gather Client Information\r\n -Start the chat by greeting the client and explaining that you’ll need their email address and a few basic details to prepare a business proposal.\r\n -The email is mandatory. If the client refuses or forgets to provide it, politely insist until you receive a valid email address before continuing.\r\n -When collecting the email address, always verify that it appears to be a valid format (must include \"@\" and a domain, e.g., example@domain.com).  \r\n -If the email is invalid or incomplete, politely ask the client to confirm or correct it before proceeding.\r\n -Ask for any basic information (e.g., name, company, role) if not already known.\r\n\r\nScrape External Data:\r\n\r\n -Ask the client to share any social profile URLs (Facebook, Instagram, LinkedIn).\r\n -For each provided link, call the appropriate tool:\r\n  >facebook_parser_tool(URL)\r\n  >instagram_parser_tool(URL)\r\n  >linkedin_parser_tool(URL)\r\n -Each tool returns structured data about the client.\r\n -Parse the data, merge it into a single coherent dataset, and avoid duplicates (if a field appears in multiple sources, keep the most complete version).\r\n\r\nReasoning and Context Awareness:\r\n\r\n-If you detect missing or insufficient data for the proposal, explain what is missing and ask the client for additional URLs or clarifications.    \r\n-If the client refuses to provide more, respect their decision and proceed with what you have.\r\n\r\nFinal Output:\r\n\r\n-After gathering enough data, confirm the final dataset with the client.\r\n-Summarize the collected information and indicate that the proposal will be prepared and sent to the provided email address.\r\n-Ensure the summary is clear, polite, and professional.\r\n\r\nExample Flow:\r\n\r\nAgent: Hi there! I’ll help you prepare a proposal — could you please share the email address where you’d like to send it?\r\nUser: Sure, it’s anna.smith@company.com\r\nAgent: Perfect, thank you! Could you also share links to any of your client professional or social profiles (Facebook, Instagram, LinkedIn)?\r\nUser: Here’s my client's LinkedIn: [link]\r\nAgent: Great, I’ll gather data from LinkedIn. Would you also like to include his/her Facebook or Instagram profiles for a more complete picture?\r\nUser: of course here's instagram URL: [link]\r\nAgent: Would you also like to add Facebook profile for even more context?\r\nUser: No, that’s enough.\r\nAgent: Understood. Let me compile his/her profile and confirm what I have so far...\r\n'''\r\n```\r\n\r\n# Workflow\r\n\r\n![workflow_graph.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/c2915e33c41cc34c15a338dcbfba45fb/workflow_graph.png)\r\n\r\n# Aktualny chat\r\n\r\n1. \r\n\r\n![Zrzut ekranu 2025-11-12 174127.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/c6310115c6144ed7d18900b4cd236197/Zrzut_ekranu_2025-11-12_174127.png){width=\"1139\" height=\"714\"}\r\n\r\n2. \r\n\r\n![Zrzut ekranu 2025-11-12 174152.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/40ddfc647dab59c59d805704861317f5/Zrzut_ekranu_2025-11-12_174152.png){width=\"1247\" height=\"726\"}\r\n\r\nJailbreaking: ![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/4c2f894bb9358b02a9ec29a25e49ec55/image.png){width=\"1665\" height=\"697\"}\r\n\r\nWprowadzone zabezpieczenia: ![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/bbd7f1562ede9912335bf8b2156530cb/image.png){width=\"1222\" height=\"279\"}\r\n\r\nPrzykładowe próby złamania po wprowadzeniu zabezpieczenia: ![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/0c6d50f5248ff4fd6a0a1bf980e05514/image.png){width=\"1464\" height=\"690\"}\r\n\r\n### Podpięcie agenta pod pętle\r\n\r\nAgent Facebookowy został podpięty pod agenta zarządzającego. Source code znajduje się w repo, tutaj prezentacja działania całego \"workflowu\". Jak widać trwa to 50 sekund, w tym czasie loguje się do fb, scrolluje i robi screeny.\r\n\r\n![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/9fee56f997f6ae8dc7c599c4f79bff4a/image.png){width=\"1101\" height=\"339\"}\r\n\r\n(tutaj widac ze agent glowny dostał odpowiedz od fb scrapera, ze nie ma loginu) ![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/caeff170779ff4487bd54bec11f62f27/image.png)\r\n\r\n### Wydobywanie dalszych linków\r\n\r\nDodatkowo jeśli chodzi o znalezienie kolejnych linków w profilu to jest to do zrobionia. FB renderuje elementy z linkami, więc jak się poczeka pare sekund to można je wydobyć z htmla ![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/b9e0f138840a22927f14fcce1ac5043d/image.png){width=\"916\" height=\"365\"}\r\n\r\n### Obecny Workflow\r\n\r\nAgenci scrapujacy zostali wrzuceni jako toole, dlatego ich nie widać\r\n\r\n![image](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/7ebad0fa3923e8dce3e6716b3e33270d/image.png){width=\"171\" height=\"168\"}\r\n\r\nDo OCR został wykorzystany mistralAI, który oprócz przekształcenia obrazu w markdown pozwala uzupełnić go o prompta i analizę co dzieje się na zdjęciach bez tekstu {photo: A collage of photos featuring Heidi Shore Schultz and friends} przykładowy rezultat:\r\n\r\n![profile3](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/76dfc099d9de6ba8f1e3fe92093066a1/profile3.png)\r\n\r\n# Heidi Shore Schultz\r\n\r\nStudied MS Marketing at Boston University Lives in Kentfield, California Married to Rob Schultz From Metuchen, New Jersey\r\n\r\nAdd your current work information Add languages you know Edit Profile\r\n\r\n{photo: A collage of photos featuring Heidi Shore Schultz and friends}\r\n\r\n**Share:** **Status** **Photo** **Link** **Video** **Question**\r\n\r\n## What's on your mind?\r\n\r\n{photo: A collage of photos featuring Heidi Shore Schultz and friends}\r\n\r\n**Heidi Shore Schultz** likes a link.\r\n\r\n{photo: A photo of food from Sol Food Puerto Rican Cuisine}\r\n\r\n**Sol Food Puerto Rican Cuisine | Got Daily Deals?** www.gotdailydeals.com\r\n\r\n$10 For $20 Worth of Food at Sol Food (811 4th Street ONLY)\r\n\r\nMay 11 at 3:12pm · Share\r\n\r\n## RECENT ACTIVITY\r\n\r\n* Heidi likes E-Tourism Summit and 7 other pages.\r\n* Heidi and Gina Bozio are now friends. · Like · Comment\r\n* \"What a sweetie! We enjoyed...\" on Robin Ornstil Bussin's album Izzy.\r\n* Heidi answered \"You get a box of six food treats in the mail... what do you want most?\" with Snacks (ie: plantain chips, kale chips, granola). · Follow · Ask Friends\r\n\r\n{photo: A photo of Heidi Shore Schultz and friends}\r\n\r\n## Heidi's Edit Profile\r\n\r\n**People You May Know** See All\r\n\r\n{photo: A photo of Cooper Pooterbottom}\r\n\r\n**Cooper Pooterbottom** 2 mutual friends Add as friend\r\n\r\n## Recommended Pages See All\r\n\r\n{photo: A photo of Barack Obama}\r\n\r\n**Barack Obama** Tasha Zahn and 18 other friends like him. Like\r\n\r\n## Sponsored Create an Ad\r\n\r\n**Love Flash Sales?** fab.com\r\n\r\nCheck out Fab.com. Save up to 70% off design objects not found on other private sales sites.\r\n\r\n## \"I LOVE your dress\" ideell.com\r\n\r\nShop daily designer sample sales.\r\n\r\n## Nordstrom Like NORDSTE Chat (10)\r\n\r\n## **Możliwości wykorzystania narzędzia:**\r\n\r\n1. Chęć spersonalizowania **reklamy** produktu/usługi, aby jak najbardziej zwiększyć możliwość sprzedaży. Na przykład, gdy chcemy sprzedawać catering to zamiast po prostu go reklamując w losowy sposób to jeśli udało nam się dowiedzieć, że dana grupa osób jest chora na cukrzyce, możemy w reklamie umieścić treść, która będzie mówiła o zaletach takiego cateringu jak na przykład niski indeks glikemiczny.\r\n2. Przeprowadzenie **testów** wewnętrznych wśród pracowników na skuteczność phishingu. Na przykład jako specjalista od cyberbezpieczeństwa przeprowadzamy szkolenie na temat złośliwych maili, a następnie przeprowadzamy taki test wysyłając spersonalizowane maile na skrzynki pracowników.\r\n3. Możliwość **ataku** poprzez phishing, który ma na celu zdobycie jakiś poufnych danych(np. loginy, hasła). Spersonalizowany atak prawdopodobnie będzie miał wyższa skuteczność niż ogólniki.\r\n\r\n# Scrappery + podpięcie\r\n\r\n![image.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/5cfbb1e18cd4aca1fcff0107bc2680ba/image.png){width=\"911\" height=\"510\"}\r\n\r\n![image.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/41fb2fe9eff361f5b51b235ffe1cf9d4/image.png){width=\"1008\" height=\"584\"}Chat po podpięciu scrappera z instagrama oraz facebooka - scrappery działają asynchronicznie, co znacząco skraca czas pozyskiwania informacji. Jak widać informacje są podsumowane i wszystko jest poprawnie ściągnięte.\r\n\r\n#### Problemy z LindkedIn\r\n\r\n* 18 listopada scrapper działał wspaniale dopóki LinkedIn nie wykrył niestandardowych działań na naszym koncie (warto nadmienić, że taki problem nie występuje przy Facebook'u - scrappujemy go już od 4 tygodni)\r\n\r\n  ![image.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/f9c0ca267732c7ee8fdc477193f21841/image.png)\r\n* trzeba by było podać numer, rozwiązywać captcha co za bardzo komplikuje samo logowanie - dlatego na ten moment musimy zaprzestać rozwoju tego scrappera.\r\n\r\n## Porównanie OCR\r\n\r\nprosty tekst:\r\n\r\n![potter.jpg](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/9112e3ed6839a6758d0b21c70582a115/potter.jpg)\r\n\r\nMistral:\r\n\r\n![Zrzut ekranu 2025-11-20 014555.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/79549525f01c308ec9b76acd224e3a86/Zrzut_ekranu_2025-11-20_014555.png){width=\"1023\" height=\"1018\"}\r\n\r\ntesseract:\r\n\r\n![Zrzut ekranu 2025-11-20 014803.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/3ce22a10de89600e9fc007658862e845/Zrzut_ekranu_2025-11-20_014803.png){width=\"1019\" height=\"1048\"}\r\n\r\nOba poradziły sobie bardzo dobrze, tesseract bierze tekst bardziej dosłownie przez co np. uwidacznia dzielenie wyrazu tak jak na zaznaczonym fragmencie. Jeśli chcielibyśmy uzyskać coś takiego używając AI moglibyśmy pewnie obudować go w prompta, żeby zwrócił na to uwagę\r\n\r\n### Bardziej skomplikowany przypadek\r\n\r\n![profile3.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/fa9d70aba16407028e5ead5b7f61b345/profile3.png)\r\n\r\nfragment odpowiedzi MistralAI:\r\n\r\n![Zrzut ekranu 2025-11-20 015255.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/0b2c218e858105413e2d26802aa05e68/Zrzut_ekranu_2025-11-20_015255.png){width=\"1044\" height=\"987\"}\r\n\r\nfragment odpowiedzi tesseract:\r\n\r\n![Zrzut ekranu 2025-11-20 015320.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/807fe1311f35d1f82c5aa73f7fb2882f/Zrzut_ekranu_2025-11-20_015320.png){width=\"1038\" height=\"1051\"}\r\n\r\nMożna zauważyć, że mistralAI zachowuje lepszą składnie, przy odpowiednim doprecyzowaniu promptem potrafi powiedzieć coś o zdjęciach, podczas gdy klasycznym podejściem możemy uzyskać tylko zwykły tekst.\r\n\r\n## Przykładowe treści generowanych maili na podstawie profilu\r\n\r\n![589866680_856857283702973_5562666756302274067_n.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/68893da1e1fe5f2249c375321e1d8b90/589866680_856857283702973_5562666756302274067_n.png){width=\"900\" height=\"274\"}\r\n\r\n![589172225_1378640937242079_524987092304646957_n.png](https://gitlab.tele.agh.edu.pl/-/project/95/uploads/d06c32d727f5b69629049dddd2293594/589172225_1378640937242079_524987092304646957_n.png){width=\"900\" height=\"338\"}\r\n\r\n## Napotkane limity:\r\n\r\nmax 6 requestow na sekunde w OCR, ewentualny problem przy odpalonych kilku instancjach na raz\r\n\r\nprzy scrapowaniu FB i IG nie wystąpił żaden problem, ale trzeba być przygotowanym na ewentualnego bana po pewnym czasie\r\n\r\n```system_prompt:=\r\n\"\"\" system_prompt = Write a complete, short, high-converting marketing email. The email must include:\r\n\r\n1. Subject line – highly clickable, curiosity-driven or benefit-driven.\r\n2. Preheader – one short sentence encouraging the open.\r\n3. Email body – dynamic, concise, easy to read, based on:\r\n- AIDA\r\n- PAS\r\n- benefit-driven language\r\n- emotions, specifics, curiosity\r\n- no fluff, no jargon\r\n\r\nMOST IMPORTANT USE DATA PROVIDED TO MAKE THE EMAIL AS RELEVANT AS POSSIBLE.\r\nYOU MUST USE SOME OF THE KEY INSIGHTS GATHERED FROM THE SCRAPED PROFILES\r\n\r\nRequirements:\r\n- The email must be light, brief, conversion-oriented, and skimmable.\r\n- Adapt the tone and style to my target audience.\r\n- Avoid long paragraphs (max 2–3 sentences each).\r\n- The entire message should increase the likelihood of clicking by building curiosity, emotion, or gentle urgency (light FOMO without aggression).\r\n\r\nInput data:\r\nProduct/service: Selling protein supplements.\r\nPrimary customer problem: Finding effective and affordable protein supplements to support muscle growth and recovery.\r\nCampaign goal: Drive sales through a limited-time discount offer.\r\nAdditional context: Link to shop is https://exampleshop.com/proteins, 20% off with code MUSCLE20.\r\n\r\nUsing these inputs, generate the final, ready-to-send marketing email.\r\n\"\"\"\r\n```\r\n\r\n# Przykład wybioru reklamy przez model na podstawie danych\r\n\r\n![image](/uploads/fe607553938a43f7527632d3842acfb6/image.png){width=\"900\" height=\"418\"}\r\n\r\n![image](/uploads/a526314d483e475927443bc5b87113f7/image.png){width=\"900\" height=\"444\"}\r\n\r\n![image](/uploads/5348ae680c63f3a607a7c6700ddb360a/image.png){width=\"900\" height=\"461\"}\r\n\r\n# Zebrane dane przed wysłaniem do agenta mailowego\r\n\r\nOkay, I have scraped the data from the Facebook and Instagram profiles you provided. Here's a summary of the information I gathered:\r\n\r\n**Email:** ocharek@gmail.com\r\n\r\n**Facebook Profile:**\