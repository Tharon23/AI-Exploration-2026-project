# Model API Keys (populate locally in .env, never commit!)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# TypeSafe AI / Jev (System One Decision Model)
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_BASE_URL=https://api.typesafe.ai/v1

# Local Model Endpoints (e.g., Ollama or vLLM)
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# Contributor Identity (for auto-tagging experiment outputs)
CONTRIBUTOR_NAME=kalab  # change to 'bartek' or 'kamil' locally

# Output & Logging
LOG_LEVEL=INFO
EXPERIMENT_OUTPUT_DIR=research/experiments
